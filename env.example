# Copy file này thành .env và chỉnh sửa giá trị cho phù hợp
FLASK_ENV=development
SECRET_KEY=change-me

# Database URL - bỏ comment và chỉnh sửa để dùng PostgreSQL/MySQL
# PostgreSQL (psycopg v3)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/meerkat
# MySQL (PyMySQL)
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/meerkat

# Admin dashboard basic auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Playwright cấu hình hiển thị
# development mặc định sẽ mở GUI (headless=false). Ghi đè bằng:
# PLAYWRIGHT_HEADLESS=0  # mở GUI
# PLAYWRIGHT_HEADLESS=1  # chạy headless
# Làm chậm thao tác để debug (ms):
# PLAYWRIGHT_SLOWMO_MS=200

# Bật profile persistent và tự xoá sau khi lấy cookie
# PLAYWRIGHT_PERSIST=1
# PLAYWRIGHT_DELETE_PROFILE=1

# Giữ trình duyệt mở cho dev quan sát
# PLAYWRIGHT_KEEP_OPEN=1

# Telegram bot
# TELEGRAM_ENABLED=1
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF... 
# TELEGRAM_CHAT_ID=123456789
