# Copy file này thành .env và chỉnh sửa giá trị cho phù hợp
FLASK_ENV=development
SECRET_KEY=change-me

# Database URL - bỏ comment và chỉnh sửa để dùng PostgreSQL/MySQL
# PostgreSQL (psycopg v3)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/meerkat
# MySQL (PyMySQL)
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/meerkat

# Admin dashboard basic auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
